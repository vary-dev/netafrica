rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function validProfileSlot(profileId) {
      return profileId == "profile-1" ||
             profileId == "profile-2" ||
             profileId == "profile-3" ||
             profileId == "profile-4";
    }

    function validProfileKeys() {
      return request.resource.data.keys().hasOnly([
        "ownerId",
        "name",
        "avatarUrl",
        "avatarStyle",
        "profileType",
        "ageGroup",
        "isKids",
        "language",
        "preferredLanguage",
        "subtitleLanguage",
        "maturityRating",
        "preferredGenres",
        "autoplayNextEpisode",
        "autoplayPreviews",
        "createdAt",
        "updatedAt"
      ]);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "account_owner"
        && request.resource.data.plan == "free"
        && request.resource.data.subscriptionStatus == "inactive";

      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["email", "displayName", "photoURL", "updatedAt"]);

      allow delete: if false;

      match /profiles/{profileId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && validProfileSlot(profileId)
          && validProfileKeys()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 32;

        allow update: if isOwner(uid)
          && validProfileSlot(profileId)
          && validProfileKeys()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "name",
            "avatarUrl",
            "avatarStyle",
            "profileType",
            "ageGroup",
            "isKids",
            "language",
            "preferredLanguage",
            "subtitleLanguage",
            "maturityRating",
            "preferredGenres",
            "autoplayNextEpisode",
            "autoplayPreviews",
            "updatedAt"
          ]);

        allow delete: if isOwner(uid)
          && validProfileSlot(profileId)
          && resource.data.ownerId == request.auth.uid;
      }
    }

    match /movies/{movieId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    match /series/{seriesId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    match /genres/{genreId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
