# Firebase web application
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary unsigned avatar uploads for development.
# Production admin/content uploads should use signed uploads from Node.js.
VITE_CLOUDINARY_CLOUD_NAME=dydg39ukk
VITE_CLOUDINARY_UPLOAD_PRESET=

# Browser-facing API base.
# Keep /api during local Vite development so requests use the dev proxy.
VITE_API_URL=/api

# Actual Node backend origin used by the Vite proxy.
# Change this only when Nganji's backend runs somewhere other than local port 5000.
VITE_BACKEND_ORIGIN=http://127.0.0.1:5000
