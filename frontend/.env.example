# Browser-facing API base.
# Keep /api during local development so Vite proxies to Node.
VITE_API_URL=/api

# Local Node/Express backend origin used by vite.config.js.
VITE_BACKEND_ORIGIN=http://127.0.0.1:5000

# Cloudinary avatar uploads.
VITE_CLOUDINARY_CLOUD_NAME=dydg39ukk
VITE_CLOUDINARY_UPLOAD_PRESET=

# Google authentication is intentionally not enabled yet.
# Nganji's backend needs a secure POST /api/auth/google endpoint that verifies
# a Google credential server-side and returns the same custom JWT.
VITE_GOOGLE_CLIENT_ID=
