# Firebase web application
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary unsigned avatar uploads for development.
# Production admin/content uploads should use signed uploads from Node.js.
VITE_CLOUDINARY_CLOUD_NAME=dydg39ukk
VITE_CLOUDINARY_UPLOAD_PRESET=

# Node/Express API
VITE_API_URL=http://localhost:5000/api

# Keep false until Nganji's Node/MySQL endpoints are available.
# When true, profile/content services use the API contract documented in docs/BACKEND_ARCHITECTURE.md.
VITE_USE_BACKEND=false
